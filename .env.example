# Copy this file to .env and fill in real values. Never commit .env.

# --- Google Cloud ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# Gemini model IDs (Model Garden). Pinned once here, read everywhere via config.py.
# Verified GA on this project's us-central1 endpoint — see scripts/list_vertex_models.md.
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_FLASH_MODEL=gemini-2.5-flash

# Vertex AI RAG Engine / Vector Search
RAG_CORPUS_DISPLAY_NAME=brainbar-production-assets
VECTOR_SEARCH_INDEX_ENDPOINT=

# Vertex AI Agent Engine (deployed crew runtime)
AGENT_ENGINE_RESOURCE_NAME=

# Memory Bank
MEMORY_BANK_AGENT_ENGINE_ID=

# Cloud Storage
# Bucket names are globally unique across GCS — prefix with your project id.
GCS_ASSETS_BUCKET=your-project-id-brainbar-assets
GCS_DAILIES_BUCKET=your-project-id-brainbar-dailies

# BigQuery (optional dailies table)
BIGQUERY_DATASET=brainbar_dailies
BIGQUERY_TABLE=takes

# --- Grafana Cloud ---
GRAFANA_CLOUD_STACK_URL=https://your-stack.grafana.net
GRAFANA_CLOUD_STACK_ID=
GRAFANA_SERVICE_ACCOUNT_TOKEN=

# Grafana MCP server: "oss" runs grafana/mcp-grafana locally/on Cloud Run with the
# service-account token above; "hosted" uses https://mcp.grafana.com/mcp (interactive
# OAuth, local dev only).
GRAFANA_MCP_MODE=oss
GRAFANA_MCP_URL=http://localhost:8000/mcp

# OTLP endpoints (Grafana Cloud OTLP gateway — metrics/logs/traces). Region varies per
# stack — get the exact endpoint, instance ID, and a scoped token (metrics:write,
# logs:write, traces:write) from your stack's Connections > Add new connection >
# OpenTelemetry (OTLP) setup page.
OTLP_ENDPOINT=https://otlp-gateway-prod-<region>.grafana.net/otlp
OTLP_INSTANCE_ID=
OTLP_API_KEY=

# Grafana AI Observability
AI_OBSERVABILITY_ENABLED=true
# Reported as OTel resource attributes so the AI Observability app can group by these.
BRAINBAR_VERSION=dev
DEPLOYMENT_ENVIRONMENT=production

# Grafana Pyroscope (continuous profiling — agents/profiling.py). Separate
# credentials from OTLP above — get these from Connections > Add new connection >
# Pyroscope on your Grafana Cloud stack.
PYROSCOPE_ENABLED=true
PYROSCOPE_SERVER_ADDRESS=
PYROSCOPE_INSTANCE_ID=
PYROSCOPE_API_KEY=

# Grafana Cloud IRM on-call paging (agents/first_ad/oncall_client.py). The inbound
# webhook URL of an IRM integration wired to a real escalation chain — Alerting & IRM
# > Integrations > New integration > Webhook.
GRAFANA_ONCALL_WEBHOOK_URL=

# Agent Observability / Sigil (agents/sigil_client.py, agents/runtime.py). Distinct
# product surface from OTLP above — conversations, per-tool traces, and evaluations in
# Grafana Cloud's native AI Observability app. Endpoint comes from Observability > AI
# Observability > Configuration on your stack; the token needs an Access Policy scoped
# sigil:write (Administration > Access Policies > Create access policy), not the
# metrics/logs/traces-scoped one OTLP_API_KEY uses above.
SIGIL_ENDPOINT=
SIGIL_INSTANCE_ID=
SIGIL_API_KEY=

# --- Model Armor (agents/model_armor_client.py) ---
# Guards agents/mcp_server.py's public tool surface against prompt injection in
# caller-supplied strings. Template is a one-time gcloud/Console resource — see the
# README's Model Armor section. Without these set, the MCP server runs unguarded,
# not degraded-but-safe — this is a security control, not an optional telemetry nicety.
MODEL_ARMOR_TEMPLATE=
MODEL_ARMOR_LOCATION=

# --- Backend / Frontend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
FRONTEND_WS_URL=ws://localhost:8080/stream
SIMULATOR_BASE_URL=http://localhost:9000

# REQUIRED for local dev, read by the SIMULATOR (not the backend): without this, the
# Simulator runs and pushes real telemetry to Grafana Cloud but never tells the backend
# a take started/cut, so the crew pipeline silently never fires — no verdict, no First
# AD action, nothing on the dashboard, and no error anywhere pointing at why. Points at
# the backend's own /internal/simulator-events endpoint.
BACKEND_WEBHOOK_URL=http://localhost:8080/internal/simulator-events

# On-set verdict latency budget (seconds) used by the Supervisor's self-governing loop
VERDICT_LATENCY_BUDGET_SECONDS=15
