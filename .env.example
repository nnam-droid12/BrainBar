# Copy this file to .env and fill in real values. Never commit .env.

# --- Google Cloud ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# Gemini model IDs (Model Garden). Pinned once here, read everywhere via config.py.
# Verified GA on this project's us-central1 endpoint — see scripts/list_vertex_models.md.
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_FLASH_MODEL=gemini-2.5-flash

# Vertex AI RAG Engine / Vector Search
RAG_CORPUS_DISPLAY_NAME=brainbar-production-assets
VECTOR_SEARCH_INDEX_ENDPOINT=

# Vertex AI Agent Engine (deployed crew runtime)
AGENT_ENGINE_RESOURCE_NAME=

# Memory Bank
MEMORY_BANK_AGENT_ENGINE_ID=

# Cloud Storage
# Bucket names are globally unique across GCS — prefix with your project id.
GCS_ASSETS_BUCKET=your-project-id-brainbar-assets
GCS_DAILIES_BUCKET=your-project-id-brainbar-dailies

# BigQuery (optional dailies table)
BIGQUERY_DATASET=brainbar_dailies
BIGQUERY_TABLE=takes

# --- Grafana Cloud ---
GRAFANA_CLOUD_STACK_URL=https://your-stack.grafana.net
GRAFANA_CLOUD_STACK_ID=
GRAFANA_SERVICE_ACCOUNT_TOKEN=

# Grafana MCP server: "oss" runs grafana/mcp-grafana locally/on Cloud Run with the
# service-account token above; "hosted" uses https://mcp.grafana.com/mcp (interactive
# OAuth, local dev only).
GRAFANA_MCP_MODE=oss
GRAFANA_MCP_URL=http://localhost:8000/mcp

# OTLP endpoints (Grafana Cloud OTLP gateway — metrics/logs/traces)
OTLP_ENDPOINT=https://otlp-gateway-prod-us-central-0.grafana.net/otlp
OTLP_INSTANCE_ID=
OTLP_API_KEY=

# Grafana AI Observability
AI_OBSERVABILITY_ENABLED=true

# --- Backend / Frontend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
FRONTEND_WS_URL=ws://localhost:8080/stream

# On-set verdict latency budget (seconds) used by the Supervisor's self-governing loop
VERDICT_LATENCY_BUDGET_SECONDS=15
