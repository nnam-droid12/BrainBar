VITE_BACKEND_HTTP_URL=http://localhost:8080
VITE_BACKEND_WS_URL=ws://localhost:8080/stream

# Base URL of your Grafana Cloud stack, e.g. https://your-stack.grafana.net — enables
# the embedded Stage Health / Crew Health panels. Left unset, the cockpit shows a
# placeholder instead of a broken iframe.
VITE_GRAFANA_BASE_URL=

# Must match agents/config.py's VERDICT_LATENCY_BUDGET_SECONDS (in ms).
VITE_LATENCY_BUDGET_MS=15000
